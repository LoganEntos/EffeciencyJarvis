# runtime data (run transcripts, upload inbox)
claude-dashboard/data/

# graphify output is regenerated
claude-dashboard/graphify-out/cache/

# local-only Claude Code settings
.claude/settings.local.json

# node noise (the app itself must stay dependency-free)
node_modules/

# OS noise
Thumbs.db
Desktop.ini

# ruflo/claude-flow runtime state (created by npx swarm/daemon calls)
.claude-flow/
.swarm/
.claude/proven-config.json
ruvector.db

# CSM-1B local TTS sidecar (venv + model cache), see scripts/csm-server.py
.csm/

# Kokoro-82M local TTS sidecar (venv + ~325MB onnx + voices bin), see scripts/kokoro-server.py
.kokoro/

# raw ECC download (adopted copy lives in .claude/skills-library/)
ECC-main/
ECC-main.zip

# Python bytecode cache (e.g. from py_compile checks of scripts/csm-server.py)
__pycache__/

# Agent worktrees (per-session, never committed)
.claude/worktrees/
